{
  "name": "rpgman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build:wasm": "cargo build -p rpgman-wasm --target wasm32-unknown-unknown && wasm-bindgen target/wasm32-unknown-unknown/debug/rpgman_wasm.wasm --target web --out-dir src/lib/wasm --out-name rpgman_wasm",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^25.9.1",
    "svelte": "^5.41.0",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0"
  }
}
