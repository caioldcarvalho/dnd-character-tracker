  "levels": {
    "1": {
      "features": [
        {
          "id": "warlock-pact-magic",
          "name": "Pact Magic",
          "description": "Your arcane research and the magic bestowed on you by your patron grant you spellcasting. Charisma is your spellcasting ability. You know two cantrips and have Pact Magic spell slots. All your Pact Magic slots are the same level (which increases as you gain Warlock levels), and you regain all expended slots when you finish a Short or Long Rest. Your Spell Save DC is 8 + your Charisma modifier + your Proficiency Bonus, and your spell attack bonus is your Charisma modifier + your Proficiency Bonus.",
          "resources": [
            {
              "id": "pact-slots",
              "name": "Pact Magic Slots",
              "kind": "points",
              "max": {
                "expr": "level-table",
                "on": { "expr": "stat", "id": { "kind": "class-level", "of": "warlock" } },
                "table": [[1, 1], [3, 2], [11, 3], [17, 4]]
              },
              "recharge": "short-rest"
            }
          ]
        },
        {
          "id": "warlock-eldritch-invocations",
          "name": "Eldritch Invocations",
          "description": "You have unearthed Eldritch Invocations, pieces of forbidden knowledge that imbue you with abiding magical ability. You know one invocation at level 1, and you learn more as you gain Warlock levels. Whenever you gain a Warlock level, you can replace one invocation you know with another for which you qualify.",
          "contributions": [
            {
              "target": { "kind": "custom", "of": "eldritch-invocations-known" },
              "op": "base",
              "value": {
                "expr": "level-table",
                "on": { "expr": "stat", "id": { "kind": "class-level", "of": "warlock" } },
                "table": [[1, 1], [2, 3], [5, 5], [7, 6], [9, 7], [12, 8], [15, 9], [18, 10]]
              },
              "note": "Eldritch Invocations Known"
            }
          ],
          "choices": [
            {
              "id": "warlock-invocations-1",
              "prompt": "Learn one Eldritch Invocation",
              "choose": 1,
              "options": {
                "kind": "named",
                "from": [
                  { "id": "agonizing-blast", "name": "Agonizing Blast" },
                  { "id": "armor-of-shadows", "name": "Armor of Shadows" },
                  { "id": "devils-sight", "name": "Devil's Sight" },
                  { "id": "eldritch-mind", "name": "Eldritch Mind" },
                  { "id": "mask-of-many-faces", "name": "Mask of Many Faces" },
                  { "id": "misty-visions", "name": "Misty Visions" },
                  { "id": "pact-of-the-blade", "name": "Pact of the Blade" },
                  { "id": "pact-of-the-chain", "name": "Pact of the Chain" },
                  { "id": "pact-of-the-tome", "name": "Pact of the Tome" }
                ]
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "id": "warlock-skills",
          "prompt": "Choose two skills",
          "choose": 2,
          "options": {
            "kind": "skills",
            "from": ["arcana", "deception", "history", "intimidation", "investigation", "nature", "religion"]
          }
        }
